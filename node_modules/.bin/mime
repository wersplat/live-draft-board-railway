#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules/mime/node_modules:/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules:/Volumes/870SSD/Active GH Projects/node_modules:/Volumes/870SSD/node_modules:/Volumes/node_modules:/node_modules:/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules/mime/node_modules:/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules:/Volumes/870SSD/Active GH Projects/node_modules:/Volumes/870SSD/node_modules:/Volumes/node_modules:/node_modules:/Volumes/870SSD/Active GH Projects/live-draft-board-railway/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../mime/cli.js" "$@"
else
  exec node  "$basedir/../mime/cli.js" "$@"
fi
